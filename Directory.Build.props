<Project>
  <PropertyGroup>
    <!-- The release workflow overrides Version from the tag; the web cache-buster reads AssemblyVersion. -->
    <Version>0.2.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <Authors>gauthier-se</Authors>
    <RepositoryUrl>https://github.com/gauthier-se/jellyfin-plugin-cinematheque</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
</Project>
